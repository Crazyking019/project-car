></block></statement></block></xml>","main.ts":"","README.md":"","main.py":"from microbit import *\nimport time\n\n# Motor control pins\nleft_motor = pin1\nright_motor = pin2\n\n# Sound sensor pin\nsound_sensor = pin0\n\n# Clap detection settings\nCLAP_THRESHOLD = 600       # Adjust based on your sensor\nCLAP_WINDOW = 1500         # Time window to count claps (ms)\nCLAP_COOLDOWN = 1000       # Delay after action (ms)\n\ndef move_forward():\n    display.show(Image.ARROW_N)\n    left_motor.write_digital(1)\n    right_motor.write_digital(1)\n    sleep(500)\n    stop()\n\ndef turn_left():\n    display.show(Image.ARROW_W)\n    left_motor.write_digital(0)\n    right_motor.write_digital(1)\n    sleep(500)\n    stop()\n\ndef turn_right():\n    display.show(Image.ARROW_E)\n    left_motor.write_digital(1)\n    right_motor.write_digital(0)\n    sleep(500)\n    stop()\n\ndef move_backward():\n    display.show(Image.ARROW_S)\n    left_motor.write_digital(0)\n    right_motor.write_digital(0)\n    sleep(500)\n    stop()\n\ndef stop():\n    left_motor.write_digital(0)\n    right_motor.write_digital(0)\n\ndef count_claps():\n    count = 0\n    start_time = running_time()\n    while running_time() - start_time < CLAP_WINDOW:\n        if sound_sensor.read_analog() > CLAP_THRESHOLD:\n            count += 1\n            sleep(200)  # Debounce delay\n    return count\n\nwhile True:\n    if sound_sensor.read_analog() > CLAP_THRESHOLD:\n        claps = count_claps()\n        if claps == 1:\n            move_forward()\n        elif claps == 2:\n            turn_left()\n        elif claps == 3:\n            turn_right()\n        elif claps == 4:\n            move_backward()\n        sleep(CLAP_COOLDOWN)","pxt.json":"{\n    \"name\": \"project car\",\n    \"description\": \"\",\n    \"dependencies\": {\n        \"core\": \"*\",\n        \"radio\": \"*\",\n        \"microphone\": \"*\"\n    },\n    \"files\": [\n        \"main.blocks\",\n        \"main.ts\",\n        \"README.md\",\n        \"main.py\"\n    ],\n    \"preferredEditor\": \"pyprj\"\n}\n"}}],"shares":[],"lastSaveTime":1760801394245}